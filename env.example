# Copy this file to .env.local for local development.
# Keep secrets out of source control.

# Server-only
DATABASE_URL=
# Aiven MySQL CA certificate in PEM format (literal or escaped newlines).
# Leave blank only for a local database that does not use TLS.
DB_CA_CERT=
# Replace this rejected placeholder with a unique random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
APP_ORIGIN=

# Optional private activity sheet (see /apps-script/README.md)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=

# Browser-visible
VITE_GOOGLE_CLIENT_ID=

# Optional comma-separated hostnames for remote development previews
DEV_ALLOWED_HOSTS=
